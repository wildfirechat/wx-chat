<import src="voice.wxml" />
<import src="extra.wxml" />
<view class="input-flex-column" catchtap="">
    <view wx:if="{{disabled}}" class="input-disabled">{{disabledTip || '暂时不能发送消息'}}</view>
    <view wx:else class="input-text-voice-super">
        <image src="../../image/chat/voice/{{inputStatus==='voice'?'keyboard':'voice'}}.png"
               class="extra-btn-style" bindtap="_change$input$way$event"/>
        <block wx:if="{{inputStatus==='voice'}}">
            <template is="voice" data="{{voiceObj:voiceObj}}"/>
        </block>
        <!-- 不自动上推页面，根据键盘高度自行调整布局，避免自定义导航栏被推出屏幕 -->
        <input wx:else
               class="chat-input-style"
               maxlength="-1" confirm-type="send" confirm-hold="{{true}}"
               adjust-position="{{false}}" hold-keyboard="{{false}}"
               focus="{{focus}}" value="{{textMessage}}" placeholder="{{placeholder}}"
               bindconfirm="_chatInput$send$text$message" bindfocus="_chatInput$bind$focus$event"
               bindblur="_chatInput$bind$blur$event" bindinput="_chatInput$getValue$event"
               bindkeyboardheightchange="_onKeyboardHeightChange"/>
        <view hover-class="press-style-opacity">
            <view wx:if="{{inputStatus==='text' && textMessage}}" class="chat-input-send-button-style" catchtap="_chatInput$send$text$message02">发送</view>
            <image wx:else class="extra-btn-style"
                   src="../../image/chat/extra.png" catchtap="_chatInput$extra$click$event" />
        </view>
    </view>
    <block wx:if="{{extraObj.chatInputShowExtra && !disabled}}">
        <view class="list-divide-line" />
        <template is="chat-extra-function-part"
                  data="{{chat$input$extra$arr:extraObj.chatInputExtraArr}}" />
    </block>
    <view class="keyboard-placeholder" style="height:{{keyboardHeight}}px;"></view>
    <view wx:if="{{!keyboardHeight}}" class="safe-area-bottom"></view>
</view>
