<template name="chat-extra-function-part">
    <view class="extra-super">
        <view wx:for="{{chat$input$extra$arr}}" wx:key="index" class="flex-column extra-item" bindtap="_chatInput$extra$item$click$event" data-index="{{index}}" data-action="{{item.action}}">
            <image class="extra-image-size" src="{{item.icon ? item.icon : ('/image/chat/extra/' + item.picName + '.png')}}" />
            <text class="extra-text-size">{{item.description}}</text>
        </view>
    </view>
</template>
