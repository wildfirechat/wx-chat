<view class="page-gray">
    <view wx:if="{{!friendRequests.length}}" class="empty-tip">暂无好友请求</view>
    <view class="section" wx:else>
        <view wx:for="{{friendRequests}}" wx:key="uid" class="cell" hover-class="cell-hover" bindtap="onItemTap" data-uid="{{item.uid}}">
            <image class="cell-avatar" src="{{item.portrait}}" mode="aspectFill"/>
            <view class="cell-body">
                <text class="cell-title">{{item.name}}</text>
                <text class="cell-desc">{{item.reason || '请求添加你为朋友'}}</text>
            </view>
            <block wx:if="{{item.status === 0}}">
                <view class="request-btn request-decline" catchtap="declineRequest" data-uid="{{item.uid}}">拒绝</view>
                <view class="request-btn request-accept" catchtap="acceptRequest" data-uid="{{item.uid}}">接受</view>
            </block>
            <text wx:elif="{{item.status === 1}}" class="request-status">已添加</text>
            <text wx:elif="{{item.status === 3}}" class="request-status">已拒绝</text>
        </view>
    </view>
</view>
