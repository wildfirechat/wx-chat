.request-btn {
    margin-left: 16rpx;
    padding: 0 24rpx;
    height: 56rpx;
    line-height: 56rpx;
    border-radius: 8rpx;
    font-size: 26rpx;
    flex-shrink: 0;
}

.request-accept {
    background-color: #3E65E4;
    color: #fff;
}

.request-decline {
    background-color: #f2f2f2;
    color: #333;
}

.request-status {
    margin-left: 16rpx;
    font-size: 26rpx;
    color: #999;
    flex-shrink: 0;
}
