.me-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 60rpx 32rpx 60rpx 40rpx;
    background-color: #fff;
}

.me-avatar {
    width: 128rpx;
    height: 128rpx;
    border-radius: 12rpx;
    flex-shrink: 0;
    background-color: #eee;
}

.me-names {
    flex: 1;
    min-width: 0;
    margin-left: 32rpx;
    display: flex;
    flex-direction: column;
}

.me-name {
    font-size: 40rpx;
    font-weight: 500;
    color: #111;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.me-account {
    margin-top: 12rpx;
    font-size: 26rpx;
    color: #888;
}
