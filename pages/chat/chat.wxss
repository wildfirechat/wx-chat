@import "../../modules/chat-page/message.wxss";

page {
    background-color: #EDEDED;
    height: 100%;
}

.chat-page {
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.scroll-view {
    flex: 1;
    height: 0;
}

.message-list {
    padding-bottom: 20rpx;
}

#bottomElement {
    height: 2rpx;
}

.new-message-tip {
    position: fixed;
    right: 24rpx;
    bottom: 200rpx;
    background-color: #fff;
    padding: 12rpx 24rpx;
    border-radius: 30rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
    color: #3E65E4;
    font-size: 24rpx;
    z-index: 100;
}

.input-area {
    flex-shrink: 0;
}

.quote-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 12rpx 20rpx;
    background-color: #F7F7F7;
    border-top: 1rpx solid #e0e0e0;
}

.quote-bar-text {
    flex: 1;
    min-width: 0;
    padding: 10rpx 16rpx;
    border-radius: 6rpx;
    background-color: #E9E9E9;
    color: #666;
    font-size: 24rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.quote-bar-close {
    width: 56rpx;
    text-align: center;
    color: #999;
    font-size: 28rpx;
}

.multi-select-bar {
    flex-shrink: 0;
    display: flex;
    flex-direction: row;
    background-color: #F7F7F7;
    border-top: 1rpx solid #e0e0e0;
    padding-bottom: constant(safe-area-inset-bottom);
    padding-bottom: env(safe-area-inset-bottom);
}

.multi-select-action {
    flex: 1;
    height: 110rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28rpx;
    color: #333;
}

.multi-select-action:active {
    background-color: #e5e5e5;
}

.multi-select-danger {
    color: #fa5151;
}
