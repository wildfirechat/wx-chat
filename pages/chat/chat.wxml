<import src="../../modules/chat-page/message.wxml"/>

<view class="chat-page">
    <nav-bar title="{{title}}" subtitle="{{subtitle}}" show-more="{{!multiSelect}}" bind:more="onNavMore"/>

    <scroll-view
            class="scroll-view"
            scroll-y="true"
            scroll-into-view="{{scrollIntoView}}"
            bindscroll="onScroll"
            bindscrolltoupper="loadOlder"
            bindscrolltolower="loadNewer"
            upper-threshold="80"
            bindtap="resetInputStatus">
        <view class="message-list">
            <block wx:for="{{chatItems}}" wx:key="key">
                <template is="message-item" data="{{item, multiSelect, highlightKey}}"/>
            </block>
        </view>
        <view id="bottomElement"></view>
    </scroll-view>

    <view wx:if="{{showNewMessageTip}}" class="new-message-tip" bindtap="onNewMessageTipClick">
        <text>↓ 有新消息</text>
    </view>

    <!-- 多选操作栏 -->
    <view wx:if="{{multiSelect}}" class="multi-select-bar">
        <view class="multi-select-action" bindtap="onMultiForwardOneByOne">
            <text>逐条转发</text>
        </view>
        <view class="multi-select-action" bindtap="onMultiForwardComposite">
            <text>合并转发</text>
        </view>
        <view class="multi-select-action multi-select-danger" bindtap="onMultiDelete">
            <text>删除</text>
        </view>
        <view class="multi-select-action" bindtap="exitMultiSelect">
            <text>取消({{selectedCount}})</text>
        </view>
    </view>

    <view hidden="{{multiSelect}}" class="input-area">
        <view wx:if="{{quote}}" class="quote-bar">
            <text class="quote-bar-text">{{quote.name}}：{{quote.digest}}</text>
            <view class="quote-bar-close" bindtap="cancelQuote">✕</view>
        </view>
        <chat-input
                id="chatInput"
                min-voice-time="{{1}}"
                max-voice-time="{{60}}"
                start-time-down="{{54}}"
                tabBarHeight="{{0}}"
                format="mp3"
                extra-array="{{extraArr}}"
                disabled="{{inputDisabled}}"
                disabled-tip="{{inputDisabledTip}}"
                bind:extraClickEvent="onExtraClickEvent"
                bind:extraItemClickEvent="onExtraItemClickEvent"
                bind:voiceRecordEvent="onVoiceRecordEvent"
                bind:sendMessageEvent="onSendMessageEvent"
                bind:mentionEvent="onMentionEvent"
                bind:textChangeEvent="onTextChangeEvent"
                bind:keyboardHeightChangeEvent="onKeyboardHeightChange">
        </chat-input>
    </view>
</view>
<!-- 用于生成图片缩略图 -->
<canvas canvas-id="canvas" style="width:200px;height:200px;position:fixed;left:-1000px;top:-1000px;"></canvas>
