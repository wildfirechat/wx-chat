@import "./voice.wxss";
@import "../loading/common.wxss";

.msg-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.msg-time {
    margin-top: 24rpx;
    color: #999;
    font-size: 22rpx;
    line-height: 32rpx;
}

.msg-notification {
    margin: 20rpx 60rpx 0 60rpx;
    padding: 6rpx 14rpx;
    border-radius: 6rpx;
    background-color: rgba(0, 0, 0, 0.06);
    color: #888;
    font-size: 24rpx;
    line-height: 36rpx;
    text-align: center;
    word-break: break-all;
}

.msg-reedit {
    margin-left: 12rpx;
    color: #3E65E4;
}

.msg-rich {
    width: 600rpx;
    margin-top: 20rpx;
    padding: 24rpx;
    box-sizing: border-box;
    background-color: #fff;
    border-radius: 12rpx;
}

.msg-rich-title {
    font-size: 30rpx;
    font-weight: 500;
    color: #111;
}

.msg-rich-desc {
    margin-top: 10rpx;
    color: #888;
    font-size: 26rpx;
}

.msg-rich-data {
    display: flex;
    margin-top: 10rpx;
    font-size: 26rpx;
}

.msg-rich-key {
    width: 160rpx;
    flex-shrink: 0;
    color: #888;
}

.msg-rich-value {
    flex: 1;
    word-break: break-all;
}

.msg-rich-footer {
    margin-top: 16rpx;
    padding-top: 12rpx;
    border-top: 1rpx solid #eee;
    font-size: 22rpx;
    color: #999;
}

/* 普通消息 */
.msg-row {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 16rpx 20rpx;
    box-sizing: border-box;
}

.msg-row-my {
    flex-direction: row-reverse;
}

.msg-row-highlight {
    background-color: rgba(250, 157, 59, 0.15);
}

.msg-check {
    width: 40rpx;
    height: 40rpx;
    margin-top: 20rpx;
    margin-right: 16rpx;
    border-radius: 50%;
    border: 2rpx solid #bbb;
    box-sizing: border-box;
    flex-shrink: 0;
    background-color: #fff;
}

.msg-row-my .msg-check {
    /* 多选框统一在左侧 */
    position: absolute;
    left: 20rpx;
    top: 16rpx;
    margin-right: 0;
}

.msg-check-on {
    border-color: #3E65E4;
    background-color: #3E65E4;
    background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCc+PHBhdGggZD0nTTYgMTJsNCA0IDgtOCcgZmlsbD0nbm9uZScgc3Ryb2tlPSd3aGl0ZScgc3Ryb2tlLXdpZHRoPSczJyBzdHJva2UtbGluZWNhcD0ncm91bmQnIHN0cm9rZS1saW5lam9pbj0ncm91bmQnLz48L3N2Zz4=");
    background-size: 100% 100%;
}

.msg-check-disabled {
    opacity: 0.3;
}

.msg-select-mask {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.msg-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 8rpx;
    flex-shrink: 0;
    background-color: #ddd;
}

.msg-main {
    max-width: 70%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin: 0 18rpx;
}

.msg-row-my .msg-main {
    align-items: flex-end;
}

.msg-sender {
    font-size: 22rpx;
    color: #888;
    margin-bottom: 6rpx;
    max-width: 400rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.msg-content-row {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.msg-row-my .msg-content-row {
    flex-direction: row-reverse;
}

.msg-content {
    max-width: 100%;
}

.msg-status {
    margin: 0 12rpx;
    display: flex;
    align-items: center;
}

.msg-fail {
    width: 40rpx;
    height: 40rpx;
}

/* 气泡 */
.bubble {
    position: relative;
    padding: 18rpx 22rpx;
    border-radius: 10rpx;
    font-size: 30rpx;
    line-height: 42rpx;
    word-wrap: break-word;
    word-break: break-all;
    white-space: pre-wrap;
}

.bubble::before {
    content: '';
    position: absolute;
    top: 26rpx;
    width: 0;
    height: 0;
    border-top: 10rpx solid transparent;
    border-bottom: 10rpx solid transparent;
}

.bubble-other {
    background-color: #fff;
    color: #333;
}

.bubble-other::before {
    left: -10rpx;
    border-right: 12rpx solid #fff;
}

.bubble-my {
    background-color: #8fcbf7;
    color: #213d52;
}

.bubble-my::before {
    right: -10rpx;
    border-left: 12rpx solid #8fcbf7;
}

.bubble-unsupported {
    color: #999;
}

.msg-call-icon {
    font-size: 26rpx;
}

/* 图片 */
.msg-image {
    display: block;
    border-radius: 8rpx;
    background-color: #e5e5e5;
}

.msg-sticker {
    background-color: transparent;
}

/* 视频 */
.msg-video {
    position: relative;
    width: 300rpx;
    height: 400rpx;
    border-radius: 8rpx;
    overflow: hidden;
    background-color: #333;
}

.msg-video-thumb {
    width: 100%;
    height: 100%;
}

.msg-video-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 80rpx;
    height: 80rpx;
    margin-left: -40rpx;
    margin-top: -40rpx;
    border-radius: 50%;
    border: 3rpx solid #fff;
    background-color: rgba(0, 0, 0, 0.35);
    box-sizing: border-box;
}

.msg-video-triangle {
    position: absolute;
    left: 30rpx;
    top: 20rpx;
    width: 0;
    height: 0;
    border-top: 18rpx solid transparent;
    border-bottom: 18rpx solid transparent;
    border-left: 28rpx solid #fff;
}

.msg-video-duration {
    position: absolute;
    right: 12rpx;
    bottom: 8rpx;
    color: #fff;
    font-size: 22rpx;
}

/* 语音 */
.msg-voice {
    display: flex;
    flex-direction: row;
    align-items: center;
    box-sizing: border-box;
    min-width: 140rpx;
}

.bubble-my.msg-voice {
    flex-direction: row-reverse;
}

.msg-voice-duration {
    margin: 0 12rpx;
    font-size: 26rpx;
}

/* 卡片类消息：文件、位置、链接、名片、聊天记录 */
.msg-card {
    width: 480rpx;
    background-color: #fff;
    border-radius: 10rpx;
    box-sizing: border-box;
    overflow: hidden;
}

.msg-card-footer {
    margin-top: 16rpx;
    padding: 10rpx 24rpx;
    border-top: 1rpx solid #eee;
    font-size: 22rpx;
    color: #999;
}

.msg-file {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 24rpx;
}

.msg-file-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.msg-file-name {
    font-size: 28rpx;
    color: #111;
    word-break: break-all;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
}

.msg-file-size {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #999;
}

.msg-file-icon {
    width: 80rpx;
    height: 90rpx;
    margin-left: 20rpx;
    flex-shrink: 0;
    border-radius: 6rpx;
    background-color: #3E65E4;
    color: #fff;
    font-size: 20rpx;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
}

.msg-location-title {
    display: block;
    padding: 18rpx 24rpx;
    font-size: 28rpx;
    color: #111;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.msg-location-map {
    display: block;
    width: 100%;
    height: 220rpx;
}

.msg-link, .msg-conference {
    padding-top: 20rpx;
}

.msg-link-title {
    display: block;
    padding: 0 24rpx;
    font-size: 28rpx;
    color: #111;
    word-break: break-all;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
}

.msg-link-body {
    display: flex;
    flex-direction: row;
    padding: 12rpx 24rpx 20rpx 24rpx;
}

.msg-link-desc {
    flex: 1;
    min-width: 0;
    padding: 0 24rpx;
    font-size: 24rpx;
    color: #999;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
}

.msg-link-body .msg-link-desc {
    padding: 0;
}

.msg-link-thumb {
    width: 96rpx;
    height: 96rpx;
    margin-left: 16rpx;
    flex-shrink: 0;
    border-radius: 4rpx;
}

.msg-user-card-body {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 24rpx 24rpx 0 24rpx;
}

.msg-user-card-portrait {
    width: 88rpx;
    height: 88rpx;
    border-radius: 8rpx;
    flex-shrink: 0;
}

.msg-user-card-name {
    margin-left: 20rpx;
    font-size: 30rpx;
    color: #111;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.msg-composite {
    padding-top: 20rpx;
}

.msg-composite-title {
    display: block;
    padding: 0 24rpx 8rpx 24rpx;
    font-size: 28rpx;
    color: #111;
}

.msg-composite-line {
    display: block;
    padding: 0 24rpx;
    font-size: 24rpx;
    line-height: 36rpx;
    color: #999;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* 引用 */
.msg-quote {
    margin-top: 10rpx;
    max-width: 100%;
    padding: 8rpx 16rpx;
    border-radius: 6rpx;
    background-color: rgba(0, 0, 0, 0.05);
    box-sizing: border-box;
}

.msg-quote-text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #888;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    word-break: break-all;
}

.msg-read {
    margin-top: 6rpx;
    font-size: 20rpx;
    color: #3E65E4;
}

.msg-read-done {
    color: #999;
}
